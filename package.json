{
  "name": "lucian-blog",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run validate && vinext build && node scripts/stage-content.mjs",
    "start": "node dist/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:friend-pr": "node scripts/check-friend-pr.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "lint": "oxlint",
    "setup:assets": "node scripts/setup-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "opencc-js": "1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0",
    "vinext": "1.4.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "oxlint": "1.76.0"
  },
  "type": "module",
  "license": "MIT",
  "overrides": {
    "fflate": "0.7.5"
  }
}
