[Unit]
Description=Lucian file-based blog
After=network.target

[Service]
Type=simple
User=blog-deploy
Group=blog-deploy
WorkingDirectory=/opt/lucian-blog/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3002
ExecStart=/usr/bin/node /opt/lucian-blog/current/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lucian-blog
UMask=0027
MemoryMax=700M

[Install]
WantedBy=multi-user.target
