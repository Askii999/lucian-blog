[Unit]
Description=Lucian file-based blog
After=network.target

[Service]
Type=simple
User=still-blog
Group=still-blog
WorkingDirectory=/opt/still-blog/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
ExecStart=/opt/still-blog/node/bin/node /opt/still-blog/current/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/still-blog
UMask=0027
MemoryMax=700M

[Install]
WantedBy=multi-user.target
